import io.airlift.http.client.HeaderName;
import io.airlift.http.client.UnexpectedResponseException;
import io.airlift.units.Duration;

import java.net.ConnectException;
import java.net.SocketException;
import java.net.SocketTimeoutException;
import java.time.Instant;
import java.util.Optional;
import java.util.Set;
import java.util.concurrent.Callable;
import java.util.concurrent.TimeUnit;
import java.util.function.Function;

{{#hasBearerAuthMethods}}
import static io.airlift.http.client.HeaderNames.WWW_AUTHENTICATE;
{{/hasBearerAuthMethods}}
import static java.util.Objects.requireNonNull;

public class RetryPolicy
{
    private static final Duration DEFAULT_INITIAL_DELAY = new Duration(100, TimeUnit.MILLISECONDS);
    private static final Duration DEFAULT_MAX_DELAY = new Duration(1, TimeUnit.SECONDS);
    private static final int DEFAULT_MAX_RETRIES = 3;
    private static final double BACKOFF_MULTIPLIER = 2.0;
    private static final Set<Integer> RETRYABLE_STATUS_CODES = Set.of(429, 502, 503, 504);

    private final int maxRetries;
    private final long initialDelayMs;
    private final long maxDelayMs;

    public RetryPolicy(int maxRetries, Duration initialDelay, Duration maxDelay)
    {
        this.maxRetries = maxRetries;
        this.initialDelayMs = requireNonNull(initialDelay, "initialDelay is null").toMillis();
        this.maxDelayMs = requireNonNull(maxDelay, "maxDelay is null").toMillis();
    }

    public static RetryPolicy withDefaults()
    {
        return new RetryPolicy(DEFAULT_MAX_RETRIES, DEFAULT_INITIAL_DELAY, DEFAULT_MAX_DELAY);
    }

    public static RetryPolicy disabled()
    {
        return new RetryPolicy(0, new Duration(0, TimeUnit.MILLISECONDS), new Duration(0, TimeUnit.MILLISECONDS));
    }

    public <T> T execute(
            String operationName,
            String method,
            String idempotencyKey,
            Function<UnexpectedResponseException, ApiException> responseExceptionFactory,
            Callable<T> operation)
    {
        requireNonNull(method, "method is null");
        requireNonNull(responseExceptionFactory, "responseExceptionFactory is null");
        requireNonNull(operation, "operation is null");

        RuntimeException lastException = null;
        int attempts = 0;
        int retryAttempt = 0;
        boolean transportRetryAllowed = isTransportRetryAllowed(method, idempotencyKey);
        while (true) {
            attempts++;
            try {
                return operation.call();
            }
            catch (RuntimeException e) {
                lastException = e;
                if (!transportRetryAllowed || retryAttempt >= maxRetries || !isRetryable(e)) {
                    break;
                }
                sleep(getDelay(e, retryAttempt));
                retryAttempt++;
            }
            catch (Exception e) {
                throw new ApiException("%s call failed".formatted(operationName), e);
            }
        }
        if (lastException instanceof UnexpectedResponseException unexpectedResponse) {
            throw responseExceptionFactory.apply(unexpectedResponse);
        }
        throw new ApiException(
                "%s call failed after %d attempts".formatted(operationName, attempts),
                lastException);
    }

{{#hasBearerAuthMethods}}
    public <T> T execute(
            String operationName,
            String method,
            String idempotencyKey,
            BearerTokenProvider tokenProvider,
            Function<UnexpectedResponseException, ApiException> responseExceptionFactory,
            Function<String, T> operation)
    {
        requireNonNull(method, "method is null");
        requireNonNull(tokenProvider, "tokenProvider is null");
        requireNonNull(responseExceptionFactory, "responseExceptionFactory is null");
        requireNonNull(operation, "operation is null");

        RuntimeException lastException = null;
        int retryAttempt = 0;
        int attempts = 0;
        boolean authenticationRetried = false;
        boolean transportRetryAllowed = isTransportRetryAllowed(method, idempotencyKey);
        while (true) {
            String bearerToken;
            try {
                bearerToken = requireNonNull(tokenProvider.getToken(), "bearer token is null");
            }
            catch (RuntimeException e) {
                throw new ApiException("%s call failed".formatted(operationName), e);
            }
            attempts++;
            try {
                return operation.apply(bearerToken);
            }
            catch (RuntimeException e) {
                lastException = e;
                // a 401 with a Bearer challenge was rejected before the server processed the request, so replaying it
                // once with a fresh token is safe for every method, including mutations without an idempotency key
                if (!authenticationRetried && isBearerChallenge(e)) {
                    try {
                        if (tokenProvider.refreshToken(bearerToken)) {
                            authenticationRetried = true;
                            continue;
                        }
                    }
                    catch (RuntimeException refreshException) {
                        throw new ApiException("%s call failed".formatted(operationName), refreshException);
                    }
                }
                if (!transportRetryAllowed || retryAttempt >= maxRetries || !isRetryable(e)) {
                    break;
                }
                sleep(getDelay(e, retryAttempt));
                retryAttempt++;
            }
        }
        if (lastException instanceof UnexpectedResponseException unexpectedResponse) {
            throw responseExceptionFactory.apply(unexpectedResponse);
        }
        throw new ApiException(
                "%s call failed after %d attempts".formatted(operationName, attempts),
                lastException);
    }

    private static boolean isBearerChallenge(RuntimeException e)
    {
        if (!(e instanceof UnexpectedResponseException response) || response.getStatusCode() != 401) {
            return false;
        }
        return response.getHeaders(WWW_AUTHENTICATE).stream()
                .anyMatch(RetryPolicy::containsBearerChallenge);
    }

    private static boolean containsBearerChallenge(String header)
    {
        int challengeStart = 0;
        boolean quoted = false;
        boolean escaped = false;
        for (int index = 0; index <= header.length(); index++) {
            if (index == header.length() && (quoted || escaped)) {
                return false;
            }
            if (index == header.length() || (header.charAt(index) == ',' && !quoted)) {
                String challenge = header.substring(challengeStart, index).strip();
                if (challenge.equalsIgnoreCase("Bearer") ||
                        (challenge.length() > "Bearer".length() &&
                                challenge.regionMatches(true, 0, "Bearer", 0, "Bearer".length()) &&
                                Character.isWhitespace(challenge.charAt("Bearer".length())) &&
                                !challenge.substring("Bearer".length()).stripLeading().startsWith("="))) {
                    return true;
                }
                challengeStart = index + 1;
                continue;
            }

            char character = header.charAt(index);
            if (escaped) {
                escaped = false;
            }
            else if (quoted && character == '\\') {
                escaped = true;
            }
            else if (character == '"') {
                quoted = !quoted;
            }
        }
        return false;
    }
{{/hasBearerAuthMethods}}

    private static boolean isTransportRetryAllowed(String method, String idempotencyKey)
    {
        return switch (method) {
            case "GET", "HEAD", "OPTIONS", "PUT", "DELETE" -> true;
            case "POST", "PATCH" -> idempotencyKey != null && !idempotencyKey.isBlank();
            default -> false;
        };
    }

    static boolean isRetryable(RuntimeException e)
    {
        if (isNetworkError(e)) {
            return true;
        }
        if (e instanceof UnexpectedResponseException ure) {
            return RETRYABLE_STATUS_CODES.contains(ure.getStatusCode());
        }
        return false;
    }

    private static boolean isNetworkError(Throwable e)
    {
        if (e instanceof SocketException || e instanceof SocketTimeoutException || e instanceof ConnectException) {
            return true;
        }
        return e.getCause() != null && isNetworkError(e.getCause());
    }

    long getDelay(RuntimeException e, int attempt)
    {
        if (e instanceof UnexpectedResponseException ure) {
            Optional<java.time.Duration> retryAfter = ure.getRetryAfter(Instant.now());
            if (retryAfter.isPresent()) {
                return Math.min(retryAfter.orElseThrow().toMillis(), maxDelayMs);
            }
        }
        return calculateDelay(attempt);
    }

    long calculateDelay(int attempt)
    {
        long delay = (long) (initialDelayMs * Math.pow(BACKOFF_MULTIPLIER, attempt));
        return Math.min(delay, maxDelayMs);
    }

    private static void sleep(long millis)
    {
        try {
            Thread.sleep(millis);
        }
        catch (InterruptedException e) {
            Thread.currentThread().interrupt();
            throw new ApiException("Retry interrupted", e);
        }
    }
}
